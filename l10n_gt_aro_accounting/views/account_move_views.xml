<odoo>

    <record id="view_move_form_inherit_retenciones" model="ir.ui.view">
        <field name="name">account.move.form.inherit.retenciones</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">

            <xpath expr="//notebook" position="inside">
                <page string="Retenciones" name="retenciones"
                      invisible="move_type not in ('in_invoice', 'in_refund', 'out_invoice', 'out_refund')">
                    <field name="tipos_retencion_permitidos_ids" invisible="1"/>
                    <field name="retencion_ids" nolabel="1">
                        <list editable="bottom">
                            <field name="tipo_id"
                                   domain="[('id', 'in', parent.tipos_retencion_permitidos_ids)]"/>
                            <field name="impuesto" optional="show"/>
                            <field name="numero_constancia"/>
                            <field name="fecha_constancia"/>
                            <field name="base" readonly="1"/>
                            <field name="amount" readonly="1" sum="Total retenido"/>
                            <field name="currency_id" column_invisible="1"/>
                        </list>
                    </field>
                    <group class="oe_subtotal_footer">
                        <field name="amount_retenido"/>
                    </group>
                    <div class="text-muted mt16">
                        Cada retención genera una línea negativa en la factura. La base se
                        calcula siempre sin considerar las líneas de retención.
                    </div>
                </page>
            </xpath>

            <!-- Aviso cuando el contacto tiene constancia de exención de IVA. -->
            <xpath expr="//div[hasclass('oe_title')]" position="before">
                <field name="partner_exento_iva" invisible="1"/>
                <field name="partner_exencion_vigente" invisible="1"/>
                <div class="alert alert-info mb-0" role="alert"
                     invisible="not partner_exento_iva or not partner_exencion_vigente">
                    Contacto exento de IVA — resolución
                    <field name="partner_exencion_resolucion" readonly="1" nolabel="1" class="oe_inline"/>
                </div>
                <div class="alert alert-warning mb-0" role="alert"
                     invisible="not partner_exento_iva or partner_exencion_vigente">
                    El contacto está marcado como exento de IVA pero su constancia no está vigente.
                </div>
            </xpath>

        </field>
    </record>

</odoo>
